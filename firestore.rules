rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Admin (CEO) Bypass
    function isCEO() {
      return request.auth != null && request.auth.uid == "MRAnZKmiEDcg5xVOjMOtbULMOtb2";
    }

    // Installments Rules
    match /installments/{installmentId} {
      allow read: if isCEO() || (request.auth != null && resource.data.userEmail == request.auth.token.email);
      allow create: if request.auth != null;
      allow update: if isCEO() || (request.auth != null && resource.data.userEmail == request.auth.token.email);
      allow delete: if isCEO();
    }

    // Reviews Rules
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow delete: if isCEO() || (request.auth != null && resource.data.userEmail == request.auth.token.email);
    }

    // Product Likes Rules
    match /product_likes/{productId} {
      allow read: if true;
      allow write: if request.auth != null || isCEO();
    }
    
    // Default deny for everything else
    match /{document=**} {
      allow read, write: if isCEO();
    }
  }
}
