rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ─── 1. CORE AUTH & PROFILES (Priority for Sign-in) ───────────
    
    match /users/{userId} {
      // Allow any authenticated user to read profiles (needed for search)
      allow read: if request.auth != null;
      // Allow users to manage their own profile document
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // ─── 2. HELPERS ───────────────────────────────────────────────
    
    function isCEO() {
      return request.auth != null && (
        request.auth.uid == "MRAnZKmiEDcg5xVOjMOtbULMOtb2" || 
        (exists(/databases/$(database)/documents/admins/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'CEO')
      );
    }

    function isAdmin() {
      return request.auth != null && (
        request.auth.uid == "MRAnZKmiEDcg5xVOjMOtbULMOtb2" || 
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // ─── 3. COLLECTIONS ───────────────────────────────────────────

    // Installments — create is blocked client-side; only server (Admin SDK) can create
    match /installments/{id} {
      allow read: if isAdmin() || (request.auth != null && (resource == null || resource.data.userEmail == request.auth.token.email));
      allow create: if false; // Only the server (Admin SDK) can create installments
      allow update: if isAdmin() || (request.auth != null && resource.data.userEmail == request.auth.token.email);
      allow delete: if isCEO();
    }

    // Receipts — create is blocked client-side; only server (Admin SDK) can create
    match /receipts/{id} {
      allow read: if isAdmin() || (request.auth != null && (resource == null || resource.data.userEmail == request.auth.token.email));
      allow create: if false; // Only the server (Admin SDK) can create receipts
      allow update: if isAdmin() || (request.auth != null && resource.data.userEmail == request.auth.token.email);
      allow delete: if isCEO();
    }

    // Admin Staff Management
    match /admins/{adminId} {
      // Allow public read so that special store queries work for unauthenticated/regular users
      allow read: if true;
      allow create, delete: if isCEO();
      allow update: if isCEO() || (
        request.auth != null && 
        request.auth.uid == adminId && 
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['specialStore'])
      );
    }

    // Site Settings
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isCEO();
    }

    // Distribution Areas (Pickup/Delivery Zones)
    match /distribution_areas/{areaId} {
      allow read: if true;
      allow write: if isCEO();
    }

    // Products
    match /products/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /cosmetics/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /wears/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /toilet_kitchen/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /furniture/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Orders — create is blocked client-side; only server (Admin SDK) can create
    match /orders/{id} {
      allow read: if isAdmin() 
                  || (request.auth != null && resource.data.userId == request.auth.uid)
                  || (request.auth != null && exists(/databases/$(database)/documents/partners/$(request.auth.uid)) && resource.data.referralCode == get(/databases/$(database)/documents/partners/$(request.auth.uid)).data.referralCode);
      allow create: if false; // Only the server (Admin SDK) can create orders
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Complaints
    match /complaints/{id} {
      allow read: if isAdmin();
      allow create: if true;
      allow update: if isAdmin();
      allow delete: if isCEO();
    }

    // Reviews & Product Interactions
    match /reviews/{id} {
      allow read: if true;
      allow create: if request.auth != null;
      allow delete: if isCEO() || (request.auth != null && resource.data.userEmail == request.auth.token.email);
    }

    match /product_likes/{id} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Visitor Tracking
    match /visitor_ids/{id} {
      allow read, create: if true;
      allow update, delete: if isCEO();
    }

    match /visitors/{document} {
      allow read: if isAdmin();
      allow create, update: if true;
      allow delete: if isCEO();
    }

    // ─── 4. NEW FEATURES (Foods & Partnerships) ───────────────────
    
    // Foods (Food Market)
    match /foods/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // Food Distribution Areas
    match /food_distribution_areas/{areaId} {
      allow read: if true;
      allow write: if isCEO();
    }
    
    // Partners
    match /partners/{userId} {
      // Allow public to read approved partners for the top earners list
      allow read: if resource == null || resource.data.status == 'approved' || isAdmin() || (request.auth != null && request.auth.uid == userId);
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if isAdmin() || (request.auth != null && request.auth.uid == userId);
      allow delete: if isCEO() || (request.auth != null && request.auth.uid == userId);
    }

    // Broadcasts
    match /broadcasts/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ─── 5. SAFETY NET ────────────────────────────────────────────
    
    match /{document=**} {
      allow read, write: if isCEO();
    }
  }
}
